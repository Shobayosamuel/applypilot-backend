# Copy to .env
ADDR=:8080
DATABASE_URL=postgres://applypilot:applypilot@localhost:5432/applypilot?sslmode=disable

# 32+ random chars: openssl rand -base64 48
JWT_SECRET=

ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL_SMART=claude-sonnet-5
CLAUDE_MODEL_FAST=claude-haiku-4-5

# AI calls per user per 24h (0 = unlimited)
AI_DAILY_LIMIT=100

# Comma-separated dashboard origins (chrome-extension:// is always allowed)
ALLOWED_ORIGINS=http://localhost:3000
# Set true only behind a trusted reverse proxy
TRUST_PROXY=false
